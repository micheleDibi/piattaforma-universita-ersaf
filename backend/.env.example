# =============================================================================
# Configurazione del backend — copia questo file in backend/.env
# =============================================================================
# .env NON va committato (lo esclude .gitignore). Questo file, con i valori
# fittizi, si'.
#
# I tre segreti qui sotto (i due PEPPER e TOTP_CHIAVE) sono segnaposto:
# l'applicazione SI RIFIUTA DI PARTIRE finche' restano tali, sono piu' corti
# di 32 byte o sono uguali fra loro. Generane tre diversi con:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# sviluppo | test | produzione
# In "produzione" la verifica di avvio diventa piu' severa: pretende
# EMAIL_BACKEND=smtp, FRONTEND_BASE_URL in https e nessun '*' nei CORS.
ERSAF_ENV=sviluppo

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Nessun valore di default nel codice: prima c'era un fallback con credenziali
# di prova cablate che, in assenza di .env, faceva connettere l'app senza
# dirlo a nessuno. La verifica di avvio rifiuta ancora quel valore.
DATABASE_URL=mysql+pymysql://utente:password@localhost:3306/nome_database

# Due database amministrativi separati, sullo stesso server del DB principale
# (stesso indirizzo, stesso utente e password), ma con nome diverso.
# Facoltativi e non ancora usati: engine e sessioni si creano solo alla prima
# richiesta esplicita. Se mancano o non sono validi, l'import resta possibile.
# Nei test questi indirizzi vengono ignorati: gli override TEST_DATABASE_URL_*
# sono ammessi solo su MariaDB loopback:3307/ersaf_test.
DATABASE_URL_GESTIONE_PAGAMENTI=mysql+pymysql://utente:password@localhost:3306/nome_database_pagamenti
DATABASE_URL_SYS_ADMIN=mysql+pymysql://utente:password@localhost:3306/nome_database_amministrazione

# -----------------------------------------------------------------------------
# Segreti — DA GENERARE, non lasciare i valori qui sotto
# -----------------------------------------------------------------------------
# Nel database non finisce mai un token in chiaro: solo SHA-256(token||pepper).
# Il pepper sta qui e NON nel database, cosi' chi legge un backup non puo'
# derivare i token. PASSWORD_RESET_TOKEN_PEPPER, SESSION_TOKEN_PEPPER e
# TOTP_CHIAVE devono essere diversi fra loro e lunghi almeno 32 byte.
PASSWORD_RESET_TOKEN_PEPPER=CAMBIAMI-genera-con-secrets-token-urlsafe-48
SESSION_TOKEN_PEPPER=CAMBIAMI-genera-con-secrets-token-urlsafe-48-e-diverso
# Cifra a riposo i segreti degli authenticator (secondo fattore del Nazionale).
# Diversa dai pepper. Se si perde, tutti devono riattivare l'app: va nel
# backup dei segreti insieme alle altre due.
TOTP_CHIAVE=CAMBIAMI-genera-con-secrets-token-urlsafe-48-ancora-diverso

# -----------------------------------------------------------------------------
# Recupero password
# -----------------------------------------------------------------------------
# Durata del link di reset, in minuti.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Richieste di reset ammesse in un'ora, contate per indirizzo IP e per email.
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5

# Durata minima garantita della risposta di /auth/password-reset/request, in
# millisecondi. Serve all'indistinguibilita': senza, il ramo "email inviata"
# (che fa cinque statement) e' sistematicamente piu' lento di quello
# "indirizzo sconosciuto" (che ne fa tre), e bastano poche decine di campioni
# per separarli. Va tenuto sopra il tempo reale del ramo piu' lento: se viene
# superato, nei log compare un warning.
PASSWORD_RESET_BUDGET_MS=900

# Base dell'URL del frontend: entra nel link della mail di reset.
FRONTEND_BASE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Sessioni
# -----------------------------------------------------------------------------
# Scorrevole: ogni uso sposta la scadenza avanti di SESSION_INATTIVITA_GIORNI e
# rimanda il cookie con lo stesso Max-Age; senza attivita' per quella finestra
# si rientra. SESSION_DURATA_MASSIMA_GIORNI e' il tetto assoluto dalla
# creazione: oltre, si rientra anche se si e' attivi. Il cambio password revoca
# comunque tutte le sessioni.
SESSION_INATTIVITA_GIORNI=14
SESSION_DURATA_MASSIMA_GIORNI=90

# Il cookie di sessione e' HttpOnly, SameSite=Lax e Secure quando
# FRONTEND_BASE_URL usa HTTPS; HTTP e' ammesso solo su localhost/loopback.

# -----------------------------------------------------------------------------
# Limiti dei tentativi di accesso
# -----------------------------------------------------------------------------
# Finestra entro cui si contano i tentativi, in secondi.
LOGIN_FINESTRA_SECONDI=900
# Tentativi per account prima delle attese progressive; si azzera a ogni accesso riuscito.
LOGIN_TENTATIVI_ACCOUNT=5
# Tentativi per indirizzo IP; include anche gli accessi riusciti.
LOGIN_TENTATIVI_IP=50
# Attesa massima in secondi: dopo la soglia si parte da 1 secondo e si raddoppia fino a qui.
LOGIN_ATTESA_MASSIMA_SECONDI=60

# -----------------------------------------------------------------------------
# Password
# -----------------------------------------------------------------------------
# Costo bcrypt. 12 e' il valore di produzione (~250 ms per hash). Nei test
# viene abbassato a 4, altrimenti la suite diventa inutilizzabile.
BCRYPT_COST=12
# Politica NIST SP 800-63B: lunghezza, non composizione. Il massimo (72 byte)
# non e' configurabile: e' il limite tecnico di bcrypt.
PASSWORD_MIN_LENGTH=8

# -----------------------------------------------------------------------------
# Passkey (WebAuthn) — secondo fattore del Nazionale
# -----------------------------------------------------------------------------
# RP ID = il dominio senza schema ne' porta. Le passkey registrate restano
# legate a questo valore: cambiarlo dopo il rilascio le rende tutte inutili.
# Le origini ammesse (separate da virgole) devono stare sotto quel dominio e
# usare HTTPS fuori da localhost. In collaudo: [dominio-collaudo] e
# https://[dominio-collaudo].
WEBAUTHN_RP_ID=localhost
# Origini ammesse, separate da virgole: devono stare sotto il dominio di
# WEBAUTHN_RP_ID e usare HTTPS fuori da localhost.
WEBAUTHN_ORIGINI=http://localhost:5173
# Nome che il browser mostra quando si registra o si usa una passkey.
WEBAUTHN_NOME=Piattaforma Università

# -----------------------------------------------------------------------------
# CORS — elenco separato da virgole
# -----------------------------------------------------------------------------
# Origini ammesse per le chiamate dal browser, separate da virgole. Con le
# sessioni a cookie devono essere esplicite: '*' non e' accettato.
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Log
# -----------------------------------------------------------------------------
# Livello minimo dei messaggi: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
# File di log, percorso relativo a backend/; vuoto per scrivere solo a schermo.
# La cartella logs/ e' esclusa da git. Un filtro di redazione toglie token,
# impronte, hash bcrypt ed email prima della scrittura, tracciamenti compresi.
LOG_FILE=logs/app.log

# -----------------------------------------------------------------------------
# Invio email
# -----------------------------------------------------------------------------
# smtp     invio reale (obbligatorio in produzione)
# file     scrive un .eml in EMAIL_FILE_DIR, per lo sviluppo
# console  stampa solo le intestazioni
# memoria  tiene i messaggi in memoria, per i test
EMAIL_BACKEND=file
# Deliberatamente FUORI da logs/: in sviluppo il link contiene il token e deve
# restare leggibile, mentre i log non devono contenere valori sensibili.
# backend/var/ e' escluso da git.
EMAIL_FILE_DIR=var/email_dev

# Server SMTP. Le credenziali stanno qui e non nella tabella della posta della
# piattaforma legacy, che le tiene in chiaro e che questa applicazione non legge.
SMTP_HOST=
# Porta del server SMTP.
SMTP_PORT=587
# Utente SMTP, se il server lo richiede.
SMTP_USER=
# Password SMTP.
SMTP_PASSWORD=
# Mittente. Il dominio di esempio va sostituito con quello dell'ambiente.
SMTP_FROM=Piattaforma Universita <noreply@example.org>
# Cifratura del canale: starttls | ssl | nessuno.
SMTP_TLS=starttls
# Timeout della connessione SMTP, in secondi.
SMTP_TIMEOUT_SECONDS=10
# Destinatario della notifica "nuova pratica caricata" (vedi
# src/pratiche/notifiche.py). Il dominio di esempio va sostituito con quello
# dell'ambiente.
EMAIL_NOTIFICHE_PRATICHE=operatore@example.org

# Canale degli SMS: skebby | memoria | file | disabilitato. In produzione deve
# essere skebby; file e memoria servono a sviluppo e test.
SMS_BACKEND=file
# Cartella in cui finiscono gli SMS quando SMS_BACKEND=file.
SMS_FILE_DIR=var/sms_dev
# Chiave utente Skebby: obbligatoria con SMS_BACKEND=skebby.
SKEBBY_USER_KEY=
# Token di accesso Skebby: obbligatorio con SMS_BACKEND=skebby.
SKEBBY_ACCESS_TOKEN=
# GP = Classic+ con ricevuta; TI = Classic. Un solo SMS per codice.
SKEBBY_MESSAGE_TYPE=GP
# Vuoto usa il mittente predefinito Skebby; altrimenti un alias autorizzato.
SKEBBY_SENDER=

# -----------------------------------------------------------------------------
# EduNews24 (notizie, interpelli e selezione del personale)
# -----------------------------------------------------------------------------
# Sorgente dei contenuti: http | memoria | disabilitato. http, il predefinito,
# chiama l'API pubblica di EduNews24; disabilitato spegne la sezione: la voce
# di menu resta, la pagina dice che non e' attiva e la Dashboard non mostra il
# riquadro; memoria usa dati inventati per sviluppo e test ed e' rifiutata in
# produzione. Per spegnere la sezione: EDUNEWS24_BACKEND=disabilitato.
EDUNEWS24_BACKEND=http
# Indirizzo base dell'API: https, senza credenziali, query o frammento, porta
# assente o 443. L'host deve essere esattamente quello dei link degli articoli
# (senza www o altre varianti), altrimenti ogni voce viene scartata.
# Obbligatorio con EDUNEWS24_BACKEND=http: il predefinito e' l'API pubblica di
# EduNews24.
EDUNEWS24_URL_BASE=https://edunews24.it/api/v1
# Contatto (URL o email) messo nello User-Agent, come chiedono i termini
# dell'API: solo caratteri ASCII stampabili, senza parentesi ne' spazi ai
# bordi, al massimo 200. Il predefinito e' l'indirizzo generico dell'ente;
# vuoto: lo User-Agent resta senza contatto.
EDUNEWS24_CONTATTO=info@ersaf.it
# Host da cui il browser carica immagini e video degli articoli, separati da
# virgole: nomi di host pubblici, senza schema, porta, percorso o caratteri
# jolly (niente IP, nomi di una sola etichetta o suffissi di rete interna).
# Il predefinito e' l'host dei media di EduNews24. Vuoto: nessuna immagine e
# nessun player.
EDUNEWS24_HOST_MEDIA=audios234567.s3.eu-north-1.amazonaws.com
# Tempo massimo per aprire la connessione verso EduNews24, in secondi (1-10).
EDUNEWS24_TIMEOUT_CONNESSIONE_SECONDI=3
# Tempo massimo di attesa fra due blocchi della risposta, in secondi (1-30).
EDUNEWS24_TIMEOUT_LETTURA_SECONDI=5
# Durata massima di una chiamata, in secondi: almeno quanto il maggiore dei due
# timeout precedenti, al massimo 30. Si controlla all'arrivo delle intestazioni
# e durante la lettura del corpo: prima valgono solo i timeout di connessione e
# di lettura, che contano ogni singola attesa.
EDUNEWS24_TIMEOUT_TOTALE_SECONDI=8
# Durata in cache di una risposta che non dichiara s-maxage ne' max-age, in
# secondi (30-3600).
EDUNEWS24_TTL_RIPIEGO_SECONDI=300
# Per quanto una copia scaduta puo' ancora coprire un guasto, in secondi (massimo 86400).
EDUNEWS24_STANTIO_MASSIMO_SECONDI=86400
# Prima pausa dopo un guasto (timeout, rete, errore del server, risposta non
# valida) o dopo un rifiuto senza Retry-After valido, in secondi (1-3600):
# raddoppia a ogni guasto consecutivo fino a 3600 e si azzera al primo successo.
EDUNEWS24_PAUSA_RIPIEGO_SECONDI=30
# Chiamate massime verso EduNews24 in 60 secondi, per tutta l'applicazione (1-40).
EDUNEWS24_RICHIESTE_AL_MINUTO=30

# Trasporto MariaDB in produzione: CA esplicita, hostname e certificato verificati.
# L'eccezione rete-privata richiede un IPv4 RFC1918 letterale e CA vuota.
# In sviluppo/test e ammesso il database locale senza TLS.
DATABASE_TRASPORTO=verify-full
DATABASE_CA_FILE=

# Chat e realtime sono parte del backend: applicare 017/018/019 prima dell'avvio.
# Keyring compatibile con Universo: elenco versione=percorso, separato da virgole.
# Ogni file contiene 32 byte casuali codificati Base64, mai una password utente.
CHAT_CHIAVI_FILE=
# Versione corrente presente nel keyring; conservare le versioni storiche.
CHAT_CHIAVE_VERSIONE=1
# File della chiave JWT condivisa (Base64), obbligatorio all'avvio del backend.
# Il servizio realtime verifica ed emette token; il percorso cookie resta distinto.
CHAT_UNIVERSO_JWT_FILE=
# Issuer e audience devono corrispondere alla sessione Universo dello stesso ambiente.
CHAT_UNIVERSO_ISSUER=universo-realtime
CHAT_UNIVERSO_AUDIENCE=universo-realtime-ws
# Origini HTTPS esplicite del client Universo, separate da virgole.
CHAT_UNIVERSO_ORIGINI=
# Scadenza di inattivita: deve coincidere con AUTH_SESSION_IDLE_TTL_SECONDS di Universo.
CHAT_UNIVERSO_INATTIVITA_SECONDI=86400

# Schema dei messaggi personali e ticket, sullo stesso MariaDB di DATABASE_URL.
REALTIME_SCHEMA_TICKET=admin_gestionale_ticket
# Durata del token di accesso in secondi (60-3600).
REALTIME_ACCESSO_SECONDI=900
# Durata assoluta della sessione e del refresh token (1-90 giorni).
REALTIME_REFRESH_GIORNI=30
# File del token separato per i produttori di notifiche, testo di 32-512 caratteri.
# Vuoto rende indisponibile soltanto POST /realtime/internal/notifications.
REALTIME_PRODUCER_TOKEN_FILE=
# Intervallo in secondi di pulizia e audit delle notifiche legacy (10-3600).
REALTIME_MANUTENZIONE_SECONDI=60
# Ammissione atomica: totale, per utente e per famiglia di autenticazione.
REALTIME_MAX_CONNECTIONS=2000
REALTIME_MAX_CONNECTIONS_PER_USER=8
REALTIME_MAX_CONNECTIONS_PER_AUTH_SESSION=4
# Comandi ordinati per utente con code limitate.
REALTIME_COMMAND_WORKERS=2
REALTIME_COMMAND_QUEUE=256
REALTIME_COMMANDS_PER_USER=8
# Memoria in uscita: frame, byte per socket e byte per processo.
REALTIME_OUTBOUND_QUEUE_FRAMES=64
REALTIME_OUTBOUND_QUEUE_BYTES=131072
REALTIME_OUTBOUND_GLOBAL_QUEUE_BYTES=134217728
# Timeout totale dell'invio, inclusa l'attesa dietro un invio bloccato.
REALTIME_SEND_TIMEOUT_MILLIS=10000
