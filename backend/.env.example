# =============================================================================
# Configurazione del backend — copia questo file in backend/.env
# =============================================================================
# .env NON va committato (lo esclude .gitignore). Questo file, con i valori
# fittizi, si'.
#
# I due PEPPER qui sotto sono segnaposto: l'applicazione SI RIFIUTA DI PARTIRE
# finche' restano tali, sono piu' corti di 32 byte o sono uguali fra loro.
# Generane due diversi con:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# sviluppo | test | produzione
# In "produzione" la verifica di avvio diventa piu' severa: pretende
# EMAIL_BACKEND=smtp, FRONTEND_BASE_URL in https e nessun '*' nei CORS.
ERSAF_ENV=sviluppo

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Nessun valore di default nel codice: prima c'era un fallback hardcoded a
# root:1234 che, in assenza di .env, faceva connettere l'app con quelle
# credenziali senza dirlo a nessuno.
DATABASE_URL=mysql+pymysql://utente:password@localhost:3306/admin_entedb

# -----------------------------------------------------------------------------
# Segreti — DA GENERARE, non lasciare i valori qui sotto
# -----------------------------------------------------------------------------
# Nel database non finisce mai un token in chiaro: solo SHA-256(token||pepper).
# Il pepper sta qui e NON nel database, cosi' chi legge un backup non puo'
# derivare i token. Le due pepper devono essere DIVERSE fra loro.
PASSWORD_RESET_TOKEN_PEPPER=CAMBIAMI-genera-con-secrets-token-urlsafe-48
SESSION_TOKEN_PEPPER=CAMBIAMI-genera-con-secrets-token-urlsafe-48-e-diverso

# -----------------------------------------------------------------------------
# Recupero password
# -----------------------------------------------------------------------------
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5

# Durata minima garantita della risposta di /auth/password-reset/request, in
# millisecondi. Serve all'indistinguibilita': senza, il ramo "email inviata"
# (che fa cinque statement) e' sistematicamente piu' lento di quello
# "indirizzo sconosciuto" (che ne fa tre), e bastano poche decine di campioni
# per separarli. Va tenuto sopra il tempo reale del ramo piu' lento: se viene
# superato, nei log compare un warning.
PASSWORD_RESET_BUDGET_MS=900

# Base dell'URL del frontend: entra nel link della mail di reset.
FRONTEND_BASE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Sessioni
# -----------------------------------------------------------------------------
SESSION_TTL_HOURS=12

# -----------------------------------------------------------------------------
# Password
# -----------------------------------------------------------------------------
# Costo bcrypt. 12 e' il valore di produzione (~250 ms per hash). Nei test
# viene abbassato a 4, altrimenti la suite diventa inutilizzabile.
BCRYPT_COST=12
# Politica NIST SP 800-63B: lunghezza, non composizione. Il massimo (72 byte)
# non e' configurabile: e' il limite tecnico di bcrypt.
PASSWORD_MIN_LENGTH=8

# -----------------------------------------------------------------------------
# CORS — elenco separato da virgole
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Log
# -----------------------------------------------------------------------------
# Percorso relativo a backend/. La cartella logs/ e' gia' esclusa da git.
# Un filtro di redazione toglie token, impronte, hash bcrypt ed email prima
# della scrittura, tracciamenti di stack compresi.
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# -----------------------------------------------------------------------------
# Invio email
# -----------------------------------------------------------------------------
# smtp     invio reale (obbligatorio in produzione)
# file     scrive un .eml in EMAIL_FILE_DIR, per lo sviluppo
# console  stampa solo le intestazioni
# memoria  tiene i messaggi in memoria, per i test
EMAIL_BACKEND=file
# Deliberatamente FUORI da logs/: in sviluppo il link contiene il token e deve
# restare leggibile, mentre i log non devono contenere valori sensibili.
# backend/var/ e' escluso da git.
EMAIL_FILE_DIR=var/email_dev

# Le credenziali stanno QUI e non nella tabella `mail` del database, che le
# contiene in chiaro: e' un'impostazione della piattaforma legacy e la nuova
# applicazione non la legge.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ERSAF <noreply@ersaf.it>
# starttls | ssl | nessuno
SMTP_TLS=starttls
SMTP_TIMEOUT_SECONDS=10
