# Copia gestita dallo script in /srv/ersaf-universita/shared/compose.env.
# Non contiene segreti: quelli stanno in api.env, db.env, db.cnf e
# source-db.cnf, generati o richiesti dallo script e mai versionati.

# Identificativo della release attiva, scritto dallo script all'attivazione.
RELEASE_TAG=20260910-120000-abc1234
# Cartella della release attiva sul server, ricavata da RELEASE_TAG.
RELEASE_DIR=/srv/ersaf-universita/releases/20260910-120000-abc1234
# Porta su cui ascolta il server web del collaudo.
WEB_PORT=18082
# Fuso orario dei container.
TZ=Europe/Rome

# Altre chiavi che gli script scrivono quando servono: ESPOSIZIONE e WEB_LAN_IP
# per la pubblicazione sulla LAN, NOTIFICHE_REALI per gli invii veri di email e
# SMS. VERSIONE_NUMERO e VERSIONE_AGGIORNATA arrivano dal deploy e non si
# scrivono qui.
