# I file eseguiti o interpretati su Linux restano con fine riga LF anche nei
# checkout Windows con core.autocrlf=true.
*.sh          text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.ps1         text eol=crlf
# Documentazione e strumenti che la generano o la controllano: LF ovunque,
# altrimenti i confronti di genera.py --verifica e del timbro vedrebbero
# differenze solo di fine riga nei checkout Windows.
*.md                       text eol=lf
scripts/documentazione/**  text eol=lf
