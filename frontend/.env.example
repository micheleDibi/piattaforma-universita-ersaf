# URL di base dell'API FastAPI. In sviluppo il backend gira sulla porta 8000.
#
# ATTENZIONE: tutto cio' che inizia con VITE_ viene incorporato nel bundle ed
# e' quindi PUBBLICO. Qui ci va un indirizzo, mai una chiave o un segreto.
VITE_API_BASE_URL=http://localhost:8000
# Nel build Docker (frontend/Dockerfile) vale /api: nginx gira le chiamate
# relative all'API sulla stessa origine, senza CORS ne' host cablati.
