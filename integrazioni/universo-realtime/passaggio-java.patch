@@ -0,0 +1,22 @@
+package it.universo.realtime.delivery;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class PracticeMessageCutoverTest {
+    @Test
+    void bloccaIlVecchioWriterPrimaDiQualsiasiAccessoAlDatabase() {
+        var writer = new PracticeMessageWriter("true");
+        var errore = assertThrows(ReliableMessageException.class,
+                () -> writer.insert(null, null));
+        assertEquals("practice_backend_changed", errore.code());
+    }
+
+    @Test
+    void configurazioneEsplicitaSenzaValoriAmbigui() {
+        assertDoesNotThrow(() -> new PracticeMessageWriter(null));
+        assertDoesNotThrow(() -> new PracticeMessageWriter("false"));
+        assertThrows(IllegalArgumentException.class, () -> new PracticeMessageWriter("yes"));
+    }
+}
