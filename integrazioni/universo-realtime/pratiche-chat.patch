+package it.universo.realtime.auth;
+
+import com.google.gson.JsonObject;
+import java.util.Set;
+
+record PracticeBridgeRequest(long userId, long clientId, String username,
+                             long practiceId, String practiceCode, long studentId, String dataset) {
+    static PracticeBridgeRequest parse(JsonObject json) {
+        if (!json.keySet().equals(Set.of("userId", "clientId", "username", "practiceId",
+                "practiceCode", "studentId", "dataset"))) throw new IllegalArgumentException();
+        return new PracticeBridgeRequest(id(json,"userId"), id(json,"clientId"),
+                text(json,"username",255), id(json,"practiceId"), text(json,"practiceCode",45),
+                id(json,"studentId"), text(json,"dataset",80));
+    }
+
+    private static long id(JsonObject json, String key) {
+        String raw = json.get(key).getAsString();
+        if (!raw.matches("[1-9][0-9]{0,18}")) throw new IllegalArgumentException();
+        long value = Long.parseLong(raw);
+        if (value < 1) throw new IllegalArgumentException();
+        return value;
+    }
+    private static String text(JsonObject json, String key, int limit) {
+        if (!json.get(key).isJsonPrimitive() || !json.get(key).getAsJsonPrimitive().isString())
+            throw new IllegalArgumentException();
+        String value = json.get(key).getAsString();
+        if (value.isBlank() || value.length()>limit || value.chars().anyMatch(Character::isISOControl))
+            throw new IllegalArgumentException();
+        return value;
+    }
+}
