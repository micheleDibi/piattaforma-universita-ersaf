+package it.universo.realtime.auth;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import it.universo.realtime.RealtimeReadAuthorization;
+import it.universo.realtime.crypto.MessageKeyContext;
+import javax.servlet.ServletException;
+import javax.servlet.http.HttpServlet;
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.sql.SQLException;
+import java.time.Instant;
+import java.util.Arrays;
+
+/** Ingresso esclusivamente tra server: non pubblicare sul reverse proxy Internet. */
+public final class PracticeBridgeServlet extends HttpServlet {
+    private byte[] secret;
+    private String dataset;
+    private final Exchange exchange;
+
+    public PracticeBridgeServlet() { exchange = PracticeBridgeServlet::issue; }
+
+    PracticeBridgeServlet(byte[] secret, String dataset, Exchange exchange) {
+        this.secret = secret.clone(); this.dataset = dataset; this.exchange = exchange;
+    }
+
+    @FunctionalInterface interface Exchange {
+        JsonObject apply(PracticeBridgeRequest input) throws SQLException;
+    }
+
+    private static JsonObject issue(PracticeBridgeRequest input) throws SQLException {
+        var user = new PracticeBridgeIdentity().find(input);
+        var principal = new AuthPrincipal(user.userId(), user.clientId(), user.companyId(), user.role(),
+                "bridge-check", "universita", Instant.now().plusSeconds(30));
+        RealtimeReadAuthorization.requireMessageAccess(principal, new MessageKeyContext(
+                MessageKeyContext.Destination.PRACTICE, String.valueOf(input.practiceId()), input.practiceCode(), null, null));
+        var issued = AuthRuntime.service().issuePracticeBridgeSession(user);
+        JsonObject result = new JsonObject();
+        result.addProperty("accessToken", issued.value());
+        result.addProperty("expiresAt", issued.expiresAt().toString());
+        result.addProperty("userId", user.userId());
+        return result;
+    }
+
+    @Override public void init() throws ServletException {
+        String file = System.getenv("UNIVERSITA_BRIDGE_SECRET_FILE");
+        dataset = System.getenv("UNIVERSITA_BRIDGE_DATASET");
+        if (file == null || file.isBlank()) return; // disabilitato fino alla configurazione esplicita
+        try {
+            secret = Files.readString(Path.of(file), StandardCharsets.UTF_8).trim().getBytes(StandardCharsets.UTF_8);
+            if (secret.length < 32 || dataset == null || dataset.isBlank()) throw new IOException();
+        } catch (IOException e) { throw new ServletException("Configurazione ponte Universita non valida"); }
+    }
+
+    @Override protected void doPost(HttpServletRequest request, HttpServletResponse response) throws IOException {
+        response.setHeader("Cache-Control", "no-store");
+        response.setHeader("X-Content-Type-Options", "nosniff");
+        if (secret == null) { response.sendError(503); return; }
+        if (!authenticated(request.getHeader("Authorization"))) { response.sendError(401); return; }
+        if (request.getContentType()==null || !request.getContentType().split(";")[0].equals("application/json")) {
+            response.sendError(415); return;
+        }
+        byte[] body = request.getInputStream().readNBytes(4097);
+        if (body.length > 4096) { response.sendError(413); return; }
+        try {
+            var input = PracticeBridgeRequest.parse(JsonParser.parseString(new String(body, StandardCharsets.UTF_8)).getAsJsonObject());
+            if (!dataset.equals(input.dataset())) { response.sendError(409); return; }
+            JsonObject result = exchange.apply(input);
+            response.setContentType("application/json;charset=UTF-8");
+            response.getWriter().write(result.toString());
+        } catch (AuthException e) { response.sendError(e.status());
+        } catch (it.universo.realtime.crypto.MessageKeyHttpException e) { response.sendError(e.status());
+        } catch (com.google.gson.JsonParseException | IllegalArgumentException | IllegalStateException | NullPointerException | UnsupportedOperationException e) { response.sendError(400);
+        } catch (SQLException e) { response.sendError(503);
+        } finally { Arrays.fill(body, (byte) 0); }
+    }
+
+    private boolean authenticated(String header) {
+        if (header == null || !header.startsWith("Bearer ") || header.length()>1024) return false;
+        byte[] supplied = header.substring(7).getBytes(StandardCharsets.UTF_8);
+        try { return MessageDigest.isEqual(secret, supplied); }
+        finally { Arrays.fill(supplied, (byte) 0); }
+    }
+    @Override public void destroy() { if (secret != null) Arrays.fill(secret, (byte) 0); }
+}
