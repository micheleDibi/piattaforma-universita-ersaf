+package it.universo.realtime.auth;
+
+import com.example.chat.db.DatabaseConfig;
+import java.sql.SQLException;
+
+/** Verifica incrociata: gli id del clone non bastano per impersonare utenti o pratiche. */
+final class PracticeBridgeIdentity {
+    private static final String QUERY = """
+        SELECT u.utente_id, c.cliente_id, COALESCE(c.azienda_id,0) azienda_id, r.ruolo_codice
+          FROM utenti u JOIN clienti c ON c.utente_id=u.utente_id
+          JOIN ruoli r ON r.ruolo_id=c.cliente_ruolo
+          JOIN pratiche p ON p.pratica_id=? AND BINARY p.pratica_numero=BINARY ? AND p.cliente_id=?
+         WHERE u.utente_id=? AND c.cliente_id=? AND BINARY u.utente_username=BINARY ?
+           AND u.utente_attivoSN=-1
+           AND (SELECT COUNT(*) FROM clienti other WHERE other.utente_id=u.utente_id)=1
+        """;
+
+    AuthenticatedUser find(PracticeBridgeRequest request) throws SQLException {
+        try (var connection = DatabaseConfig.getConnection(DatabaseConfig.DatabaseType.PRACTICE);
+             var query = connection.prepareStatement(QUERY)) {
+            query.setQueryTimeout(3);
+            query.setLong(1, request.practiceId()); query.setString(2, request.practiceCode());
+            query.setLong(3, request.studentId()); query.setLong(4, request.userId());
+            query.setLong(5, request.clientId()); query.setString(6, request.username());
+            try (var result = query.executeQuery()) {
+                if (!result.next()) throw AuthException.unauthorized();
+                return new AuthenticatedUser(String.valueOf(result.getLong("utente_id")),
+                        result.getLong("cliente_id"), "", result.getString("ruolo_codice"),
+                        result.getLong("azienda_id"));
+            }
+        }
+    }
+}
