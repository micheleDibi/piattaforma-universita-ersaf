+import static org.junit.jupiter.api.Assertions.*;
+
+class PracticeBridgeTest {
+    private static final String KEY = "synthetic-bridge-key-" + "x".repeat(32);
+    private static final String BODY = """
+        {"userId":10,"clientId":100,"username":"prova","practiceId":101,
+         "practiceCode":"PR-101","studentId":102,"dataset":"synthetic"}
+        """;
+
+    @Test void requiresExactIdentityAndDatasetShape() {
+        assertEquals(101, PracticeBridgeRequest.parse(JsonParser.parseString(BODY).getAsJsonObject()).practiceId());
+        for (String invalid : new String[]{BODY.replace("101", "0"), BODY.replace("101", "1.5"),
+                BODY.replace("101", "9223372036854775808"), BODY.replace("\"prova\"", "null"),
+                BODY.replace("\"synthetic\"", "\"\""), BODY.replace("\"userId\":10", "\"extra\":1,\"userId\":10")}) {
+            assertThrows(RuntimeException.class, () -> PracticeBridgeRequest.parse(JsonParser.parseString(invalid).getAsJsonObject()));
+        }
+    }
+
+    @Test void rejectsBeforeIssuingAnySession() throws Exception {
+        AtomicInteger calls = new AtomicInteger();
+        var servlet = new PracticeBridgeServlet(KEY.getBytes(StandardCharsets.UTF_8), "synthetic", request -> {
+            calls.incrementAndGet(); return new JsonObject();
+        });
+        assertEquals(401, invoke(servlet, "wrong", BODY));
+        assertEquals(409, invoke(servlet, KEY, BODY.replace("synthetic", "other")));
+        assertEquals(413, invoke(servlet, KEY, "x".repeat(4097)));
+        assertEquals(400, invoke(servlet, KEY, "{bad-json"));
+        assertEquals(400, invoke(servlet, KEY, BODY.replace("101", "[]")));
+        assertEquals(0, calls.get());
+        assertEquals(200, invoke(servlet, KEY, BODY));
+        assertEquals(1, calls.get());
+    }
+
+    @Test void propagatesParticipationDenialWithoutIssuingTokens() throws Exception {
+        var servlet = new PracticeBridgeServlet(KEY.getBytes(StandardCharsets.UTF_8), "synthetic", request -> {
+            throw it.universo.realtime.crypto.MessageKeyHttpException.denied();
+        });
+        assertEquals(403, invoke(servlet, KEY, BODY));
+    }
+
+    @Test void bridgeAccessHasFourMinuteAbsoluteLifetimeAndNoRefreshResponse() throws Exception {
+        Instant now = Instant.parse("2026-09-28T08:00:00Z");
+        Clock clock = Clock.fixed(now, ZoneOffset.UTC);
+        var config = new AuthConfig(KEY.getBytes(StandardCharsets.UTF_8), "issuer", "audience",
+                Duration.ofMinutes(15), Duration.ofDays(30), Duration.ofMinutes(30),
+                Duration.ofMinutes(1), Set.of("https://example.test"));
+        AuthSessionStore store = (AuthSessionStore) Proxy.newProxyInstance(getClass().getClassLoader(),
+                new Class<?>[]{AuthSessionStore.class}, (proxy, method, args) -> {
+                    if (!method.getName().equals("create")) throw new UnsupportedOperationException();
+                    NewAuthSession pending = (NewAuthSession) args[0];
+                    assertEquals(now.plusSeconds(240), pending.refreshExpiresAt());
+                    assertEquals("universita-practice-bridge", pending.deviceId());
+                    return new StoredAuthSession(pending.sessionId(), pending.user().userId(), pending.user().clientId(),
+                            pending.user().companyId(), pending.user().role(), pending.deviceId(), pending.refreshExpiresAt());
+                });
+        var jwt = new JwtTokenService(config, clock);
+        var service = new AuthService(config, new LegacyCredentialRepository(), store, jwt, new SecureRandom(), clock);
+        var issued = service.issuePracticeBridgeSession(new AuthenticatedUser("10", 100, "", "Utente", 200));
+        assertEquals(now.plusSeconds(240), issued.expiresAt());
+        assertEquals(100, jwt.verify(issued.value()).clientId());
+    }
+
+    private int invoke(PracticeBridgeServlet servlet, String key, String body) throws Exception {
+        var stream = new ByteArrayInputStream(body.getBytes(StandardCharsets.UTF_8));
+        ServletInputStream input = new ServletInputStream() {
+            public boolean isFinished() { return stream.available() == 0; }
+            public boolean isReady() { return true; }
+            public void setReadListener(ReadListener listener) { throw new UnsupportedOperationException(); }
+            public int read() { return stream.read(); }
+        };
+        var request = (HttpServletRequest) Proxy.newProxyInstance(getClass().getClassLoader(), new Class<?>[]{HttpServletRequest.class},
+            (p, m, a) -> switch (m.getName()) {
+                case "getHeader" -> "Bearer " + key;
+                case "getContentType" -> "application/json";
+                case "getInputStream" -> input;
+                default -> throw new UnsupportedOperationException(m.getName());
+            });
+        AtomicInteger status = new AtomicInteger(200);
+        var response = (HttpServletResponse) Proxy.newProxyInstance(getClass().getClassLoader(), new Class<?>[]{HttpServletResponse.class},
+            (p, m, a) -> { switch (m.getName()) {
+                case "sendError", "setStatus" -> status.set((int) a[0]);
+                case "getWriter" -> { return new PrintWriter(new StringWriter()); }
+                case "setHeader", "setContentType" -> { }
+                default -> throw new UnsupportedOperationException(m.getName());
+            } return null; });
+        servlet.doPost(request, response);
+        return status.get();
+    }
+}
